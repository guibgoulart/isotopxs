# Copie para .env (nunca commitar o .env de verdade) e preencha.
# Em produção (Netlify), configure estas mesmas chaves em Site settings → Environment variables.

# --- Mercado Pago (Checkout Pro) ---
# Access token da conta/aplicação Mercado Pago. Use um token de TESTE (começa com TEST-)
# enquanto estivermos em desenvolvimento — nunca um token de produção (APP_USR-...) aqui.
MP_ACCESS_TOKEN=TEST-0000000000000000000000000000000-000000-00000000000000000000000000000000-000000000

# Segredo usado pela Mercado Pago para assinar as notificações de webhook. Encontrado em:
# painel do desenvolvedor → sua aplicação → Webhooks. OBRIGATÓRIO em produção — sem isso,
# netlify/functions/mp-webhook.mjs recusa qualquer notificação (fail-closed) e nenhum pagamento
# é confirmado. Só fica opcional rodando local via `netlify dev` (que define NETLIFY_DEV=true).
MP_WEBHOOK_SECRET=

# Base da API da Mercado Pago. Só mude isso para apontar para um mock local durante testes
# (ex.: http://localhost:8888/.netlify/functions/__mock-mp) — em produção deixe em branco
# para usar o padrão https://api.mercadopago.com.
MP_API_BASE=

# --- Melhor Envio (cotação de frete real) ---
# Token de acesso gerado em melhorenvio.com.br → Configurações → Permissões de acesso → Tokens
# (precisa do escopo shipping-calculate; vale ~1 ano). Com ele, o frete cobrado do cliente é o
# preço real das etiquetas no Melhor Envio. Sem ele, cai no mock abaixo (preço inventado).
MELHOR_ENVIO_TOKEN=
# IDs de serviço oferecidos no checkout (padrão: 1,2,17 = Correios PAC, SEDEX e Mini Envios).
MELHOR_ENVIO_SERVICES=
# Dias úteis entre o pagamento e a postagem, somados ao prazo informado ao cliente (padrão: 2).
SHIPPING_HANDLING_DAYS=

# --- Loggi (frete) ---
# Código de integração fornecido pela Loggi ao fechar uma conta/parceria. Enquanto isso não
# existir, netlify/functions/lib/shipping.js usa automaticamente uma cotação simulada (mock)
# realista, sem precisar desta variável.
LOGGI_INTEGRATION_CODE=
LOGGI_API_BASE=https://staging.loggi.com

# --- Site ---
# URL pública do site nesta configuração (usada para montar back_urls e notification_url
# da preferência do Mercado Pago). Em produção, defina como https://isotopxs.com.
SITE_URL=http://localhost:8888

# CEP de origem dos envios (endereço de despacho da banda/fornecedor), usado na cotação de frete.
ORIGIN_CEP=01310930

# --- Observabilidade ---
# DSN do projeto Sentry (Settings → Projects → [seu projeto] → Client Keys (DSN)). Usado por
# netlify/functions/lib/sentry.mjs pra reportar erros das functions (pagamento, frete, webhook).
# É uma credencial pública por natureza (só permite enviar eventos, não ler nada). Deixe vazio pra
# desativar — as functions continuam funcionando normalmente, só sem reportar erros pro Sentry.
SENTRY_DSN=

# --- PostHog (analytics server-side) ---
# Chave pública do projeto PostHog (começa com "phc_"). Encontrada em Project Settings → Project API Key.
# É pública por natureza — só permite enviar eventos, não ler dados. Deixe vazio para desativar
# o tracking server-side sem afetar o funcionamento das functions.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Painel de pedidos (admin.html) ---
# Senha compartilhada da banda pra entrar no painel (mínimo 12 caracteres). Trocar a senha derruba
# todas as sessões abertas. Sem ela (ou sem o segredo abaixo), o painel fica fechado pra todo mundo.
ADMIN_PASSWORD=
# Segredo aleatório pra assinar o cookie de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- E-mails (Resend) ---
# Confirmação de compra e "pedido enviado" pro cliente, e alerta de pedido novo pra banda. Sem essas
# duas, nenhum e-mail sai (o resto funciona normal). O domínio do remetente precisa estar verificado
# no Resend (registros DNS em isotopxs.com.br).
RESEND_API_KEY=
RESEND_FROM_EMAIL=ISOTOPXS <pedidos@isotopxs.com.br>
# Opcional: pra onde vão as respostas dos clientes (senão vão pro remetente acima).
EMAIL_REPLY_TO=

# --- Alerta de pedido novo pra banda ---
# E-mails que recebem o aviso de pedido pago (separados por vírgula).
BAND_NOTIFY_EMAILS=
# WhatsApp via CallMeBot: pares telefone:apikey separados por vírgula, com código do país.
# Ex.: 5551999990000:123456,5551988880000:654321 — cada pessoa ativa o próprio número (ver STACK.md).
BAND_NOTIFY_WHATSAPP=
